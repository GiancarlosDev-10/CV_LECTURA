# Copia este archivo como .env.local y completa los valores del proyecto Supabase DEV.
# .env.local NUNCA se sube al repositorio.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Clave secreta: solo servidor (procesamiento y seed). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# IA: "simulado" (sin costo, por defecto) u "openai"
EXTRACTOR_IA=simulado
OPENAI_API_KEY=
# Versión exacta del modelo (se registra en cada postulación y en E07)
OPENAI_MODEL=
# Vacío = no se envía (algunos modelos no aceptan temperature)
OPENAI_TEMPERATURE=0
