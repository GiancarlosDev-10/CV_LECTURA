# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# material del docente (no se publica)
/docs/curso/

# reportes generados localmente
/playwright-report/
/test-results/

# CVs reales (datos personales): nunca al repo público
/docs/cvs/

# Dataset: el CV de más de 5 MB se regenera con npm run dataset
/dataset/pdf/cv-40-mas-de-5mb.pdf

# Corridas de preparación (no son evidencia oficial)
/dataset/corridas/local-*
/pruebas/carga/.cookies.json
